{
    "openapi": "3.0.0",
    "info": {
        "title": "Feedback Analysis API",
        "description": "API to analyze feedback sentiment and summary.",
        "version": "1.0.0"
    },
    "paths": {
        "/api/analyse-feedback": {
            "post": {
                "tags": [
                    "Feedback"
                ],
                "summary": "Analyze feedback sentiment and summary",
                "operationId": "dc99d15f39fbbf032db9d021e2861ec2",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "feedback_text"
                                ],
                                "properties": {
                                    "feedback_text": {
                                        "type": "string",
                                        "example": "The product is great but delivery was slow."
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Successful response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "summary": {
                                            "type": "string",
                                            "example": "Product good, delivery slow"
                                        },
                                        "sentiment": {
                                            "type": "string",
                                            "example": "neutral"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation error"
                    }
                }
            }
        }
    },
    "tags": [
        {
            "name": "Feedback",
            "description": "Feedback"
        }
    ]
}